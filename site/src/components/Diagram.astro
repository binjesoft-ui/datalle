---
// Small SVG diagram renderer: boxes with a title and up to three lines, plus arrows and optional dashed groups.
export interface Box { x: number; y: number; w: number; h: number; title: string; lines?: string[]; kind?: 'accent' | 'plain' | 'muted' }
export interface Group { x: number; y: number; w: number; h: number; label: string; dashed?: boolean }
export interface Arrow { from: [number, number]; to: [number, number]; label?: string }
interface Props { width: number; height: number; label: string; boxes: Box[]; groups?: Group[]; arrows?: Arrow[] }
const { width, height, label, boxes, groups = [], arrows = [] } = Astro.props;
const id = 'arr' + Math.random().toString(36).slice(2, 8);
---
<div class="diagram">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label}>
    <defs>
      <marker id={id} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="arrowhead" />
      </marker>
    </defs>
    {groups.map((g) => (
      <g>
        <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="12" class={g.dashed ? 'grp dashed' : 'grp'} />
        <text x={g.x + 12} y={g.y + 20} class="grp-label">{g.label}</text>
      </g>
    ))}
    {arrows.map((a) => (
      <g>
        <line x1={a.from[0]} y1={a.from[1]} x2={a.to[0]} y2={a.to[1]} class="arrow" marker-end={`url(#${id})`} />
        {a.label && <text x={(a.from[0] + a.to[0]) / 2 + 8} y={(a.from[1] + a.to[1]) / 2 + 4} class="arrow-label">{a.label}</text>}
      </g>
    ))}
    {boxes.map((b) => (
      <g>
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="8" class={`box ${b.kind ?? 'plain'}`} />
        <text x={b.x + b.w / 2} y={b.y + 20} class="box-title">{b.title}</text>
        {(b.lines ?? []).map((l, i) => <text x={b.x + b.w / 2} y={b.y + 38 + i * 16} class="box-line">{l}</text>)}
      </g>
    ))}
  </svg>
</div>

<style>
  .diagram { overflow-x:auto; margin:1rem 0 1.5rem; background:var(--card); border:1px solid var(--line); border-radius:10px; padding:.75rem; }
  svg { display:block; width:100%; min-width:560px; height:auto; font-family:system-ui, sans-serif; }
  .box { fill:var(--bg); stroke:var(--line); stroke-width:1.2; }
  .box.accent { stroke:var(--accent); fill:color-mix(in srgb, var(--accent) 10%, var(--bg)); }
  .box.muted { stroke-dasharray:4 3; }
  .grp { fill:none; stroke:var(--muted); stroke-width:1; opacity:.6; }
  .grp.dashed { stroke-dasharray:6 4; stroke:var(--accent); opacity:.8; }
  .grp-label { fill:var(--muted); font-size:12px; font-weight:600; }
  .box-title { fill:var(--fg); font-size:13px; font-weight:600; text-anchor:middle; }
  .box-line { fill:var(--muted); font-size:11.5px; text-anchor:middle; }
  .arrow { stroke:var(--muted); stroke-width:1.4; }
  .arrowhead { fill:var(--muted); }
  .arrow-label { fill:var(--accent); font-size:11px; font-style:italic; }
</style>
