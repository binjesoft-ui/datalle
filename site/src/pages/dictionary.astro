---
import Base from '../layouts/Base.astro';
---
<Base title="Data dictionary">
  <h1>Data dictionary and lineage</h1>
  <p class="lede">
    Every table and column is documented inside Unity Catalog itself (as table and column comments), and this page is
    generated from the catalog's <code>information_schema</code>, so it cannot drift from what is really in the lakehouse.
    Click a table to see what it is built from and what depends on it.
  </p>

  <div id="error" class="banner hidden"></div>
  <p id="lineage-source" class="lede small"></p>

  <div id="lineage" class="lineage" aria-label="Table lineage">
    <svg id="edges" aria-hidden="true"></svg>
    <div class="layers" id="layers"></div>
  </div>

  <h2>Tables and columns</h2>
  <input id="search" type="search" placeholder="Search tables, columns or descriptions…" aria-label="Search the dictionary" />
  <p id="count" class="lede small"></p>
  <div id="tables"></div>
</Base>

<style is:global>
  .small { font-size:.85rem; }
  .hidden { display:none; }
  .lineage { position:relative; margin:1.25rem 0 0; }
  .lineage svg { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; overflow:visible; }
  .layers { position:relative; display:grid; grid-template-columns:repeat(3,1fr); gap:2.5rem; }
  .layer h3 { margin:0 0 .5rem; font-size:.8rem; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); }
  .node { display:block; width:100%; text-align:left; margin:0 0 .5rem; padding:.45rem .6rem; font:inherit; font-size:.8rem;
          background:var(--card); color:var(--fg); border:1px solid var(--line); border-radius:8px; cursor:pointer;
          overflow-wrap:anywhere; }
  .node:hover, .node:focus-visible { border-color:var(--accent); outline:none; }
  .node.sel { border-color:var(--accent); background:color-mix(in srgb, var(--accent) 16%, var(--card)); }
  .node.rel { border-color:var(--accent); }
  .node.dim { opacity:.35; }
  .edge { fill:none; stroke:var(--muted); stroke-width:1.2; opacity:.35; }
  .edge.on { stroke:var(--accent); opacity:1; stroke-width:2; }
  #search { width:100%; max-width:30rem; padding:.55rem .75rem; font:inherit; background:var(--card); color:var(--fg);
            border:1px solid var(--line); border-radius:8px; }
  details.tbl { background:var(--card); border:1px solid var(--line); border-radius:10px; margin:.6rem 0; padding:.2rem 1rem; }
  details.tbl summary { cursor:pointer; padding:.6rem 0; }
  details.tbl summary .meta { color:var(--muted); font-size:.8rem; margin-left:.5rem; }
  details.tbl table { margin:.25rem 0 .75rem; }
  .pill { display:inline-block; font-size:.7rem; padding:.05rem .45rem; border-radius:999px; border:1px solid var(--line); color:var(--muted); margin-right:.4rem; }
  .empty-c { color:var(--accent); font-style:italic; }
  @media (max-width:640px) { .layers { gap:.75rem; } .node { font-size:.7rem; padding:.35rem .4rem; } }
</style>

<script>
  import { LAYERS, related, filterTables, columnsByLayer, esc, undocumentedCount } from '../lib/dictionary.ts';
  import type { Table, Edge, Node } from '../lib/dictionary.ts';

  const $ = (id: string) => document.getElementById(id)!;
  const get = async (name: string) => {
    const r = await fetch(`/data/${name}.json`);
    if (!r.ok) throw new Error(`Could not load /data/${name}.json (${r.status})`);
    return r.json();
  };

  let dict: { tables: Table[]; catalog: string; schema: string; generated_at: string };
  let lineage: { nodes: Node[]; edges: Edge[]; source: string };
  let selected: string | null = null;

  function drawEdges() {
    const svg = $('edges');
    const box = $('lineage').getBoundingClientRect();
    const rel = selected ? related(selected, lineage.edges) : null;
    svg.innerHTML = lineage.edges.map((e) => {
      const a = document.querySelector<HTMLElement>(`[data-node="${CSS.escape(e.from)}"]`);
      const b = document.querySelector<HTMLElement>(`[data-node="${CSS.escape(e.to)}"]`);
      if (!a || !b) return '';
      const ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
      const x1 = ra.right - box.left, y1 = ra.top + ra.height / 2 - box.top;
      const x2 = rb.left - box.left, y2 = rb.top + rb.height / 2 - box.top;
      const mx = (x1 + x2) / 2;
      const on = rel && (
        (e.from === selected || rel.up.has(e.from) || rel.down.has(e.from)) &&
        (e.to === selected || rel.up.has(e.to) || rel.down.has(e.to)) &&
        ((rel.up.has(e.from) || e.from === selected) && (rel.up.has(e.to) || e.to === selected) ||
         (rel.down.has(e.to) || e.to === selected) && (rel.down.has(e.from) || e.from === selected)));
      return `<path class="edge${on ? ' on' : ''}" d="M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}"/>`;
    }).join('');
  }

  function drawNodes() {
    const rel = selected ? related(selected, lineage.edges) : null;
    const by = columnsByLayer(lineage.nodes);
    $('layers').innerHTML = LAYERS.map((l) => `
      <div class="layer"><h3>${l}</h3>${(by[l] ?? []).map((n) => {
        const cls = selected === n.name ? 'sel' : rel ? (rel.up.has(n.name) || rel.down.has(n.name) ? 'rel' : 'dim') : '';
        return `<button class="node ${cls}" data-node="${esc(n.name)}">${esc(n.name)}</button>`;
      }).join('')}</div>`).join('');
    document.querySelectorAll<HTMLElement>('.node').forEach((el) =>
      el.addEventListener('click', () => select(el.dataset.node!)));
    drawEdges();
  }

  function select(name: string) {
    selected = selected === name ? null : name;
    drawNodes();
    if (selected) {
      const d = document.querySelector<HTMLDetailsElement>(`details[data-table="${CSS.escape(selected)}"]`);
      if (d) { d.open = true; }
    }
  }

  function drawTables() {
    const list = filterTables(dict.tables, (document.getElementById('search') as HTMLInputElement).value);
    $('count').textContent = `${list.length} of ${dict.tables.length} tables · ${dict.tables.reduce((n, t) => n + t.columns.length, 0)} columns documented in Unity Catalog ` +
      `(${dict.catalog}.${dict.schema}), exported ${dict.generated_at.slice(0, 10)}`;
    $('tables').innerHTML = list.map((t) => `
      <details class="tbl" data-table="${esc(t.name)}">
        <summary><span class="pill">${esc(t.layer)}</span><strong>${esc(t.name)}</strong>
          <span class="meta">${t.rows == null ? '' : Number(t.rows).toLocaleString() + ' rows · '}${t.columns.length} columns</span>
          <div class="lede small">${esc(t.comment) || '<span class="empty-c">no description</span>'}</div></summary>
        <table><thead><tr><th>Column</th><th>Type</th><th>Description</th></tr></thead><tbody>
          ${t.columns.map((c) => `<tr><td><code>${esc(c.name)}</code></td><td>${esc(c.type)}</td>
            <td>${esc(c.comment) || '<span class="empty-c">no description</span>'}</td></tr>`).join('')}
        </tbody></table>
      </details>`).join('');
  }

  try {
    [dict, lineage] = await Promise.all([get('data_dictionary'), get('lineage')]);
    $('lineage-source').textContent = `Lineage source: ${lineage.source}.`;
    drawNodes();
    drawTables();
    document.getElementById('search')!.addEventListener('input', drawTables);
    window.addEventListener('resize', drawEdges);
    if (undocumentedCount(dict.tables) > 0) console.info('Some columns have no description');
  } catch (e) {
    const b = $('error');
    b.textContent = (e as Error).message;
    b.classList.remove('hidden');
    $('lineage').classList.add('hidden');
  }
</script>
